# SMS provider
SMS__API_KEY=
# Recommended default for SMS-Activate (fallback)
SMS__API_URL=https://sms-activate.ru/stubs/handler_api.php
# Recommended default for Partner REST API (preferred)
SMS__PARTNER_URL=https://46.21.159.86/partner
SMS__SERVICE=Microsoft
SMS__SERVICES=["Microsoft"]
SMS__COUNTRY=all
SMS__MAX_PRICE=0
SMS__TIMEOUT=30
SMS__MAX_SMS_WAIT=300

# Proxy pool
PROXY__ENABLED=false
PROXY__MODE=static
PROXY__TYPE=http
PROXY__PROXIES=["proxy1:port:user:pass","proxy2:port:user:pass"]
PROXY__ROTATION_URL=
PROXY__DEAD_TIMEOUT=300

# Worker
WORKER__THREADS=10
WORKER__TOTAL_REGISTRATIONS=100
WORKER__HEADLESS=true
WORKER__RETRY_COUNT=3
WORKER__MIN_BALANCE=20

# Database
DATABASE__TYPE=sqlite
DATABASE__SQLITE_PATH=accounts.db
DATABASE__POSTGRES_URL=

# Browser
BROWSER__BACKEND=camoufox

# Camoufox
CAMOUFOX__ENABLED=true
CAMOUFOX__HEADLESS=true
CAMOUFOX__LOCALE=ru-RU
CAMOUFOX__TIMEZONE_ID=Europe/Moscow
CAMOUFOX__VIEWPORT_WIDTH=1366
CAMOUFOX__VIEWPORT_HEIGHT=768
CAMOUFOX__PERSISTENT_CONTEXT=false
CAMOUFOX__DEBUG=false

# ML
ML__ENABLED=true
ML__MODEL_PATH=ml_model.json
ML__MIN_SAMPLES=10
